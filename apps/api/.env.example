# Copy to .env and fill in. Lines starting with # are optional; the value shown is the default.

# --- Required ---------------------------------------------------------------
APP_NAME=Uraan AI
APP_ENV=development            # production in deployment (switches logs to JSON)
# Supabase "Session pooler" connection string, with the postgresql+psycopg:// prefix.
DATABASE_URL=postgresql+psycopg://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
# The secret (service role) key from Supabase > Project Settings > API, not the public one.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- AI (at least one key; providers are tried in the order of AI_PROVIDERS) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDERS=openai,gemini,anthropic
# AI_REQUEST_TIMEOUT=60

# --- Addresses --------------------------------------------------------------
# Websites allowed to call the API from a browser, comma separated (no trailing slash).
CORS_ORIGINS=http://localhost:3000
# Used for the links inside emails.
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# --- Email (Resend). Without a key no email is sent. -------------------------
# RESEND_API_KEY=
# EMAIL_FROM=Uraan AI <noreply@yourdomain.com>
# EMAIL_OUTBOX_DIR=            # development: write emails to files instead

# --- Admin portal: these emails become admins on first sign-in ----------------
# ADMIN_EMAILS=you@example.com

# --- Push notifications (python scripts/generate_vapid_keys.py) ---------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# --- Monitoring (each is off until set) --------------------------------------
# SENTRY_DSN=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Limits and logging ------------------------------------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_URI=memory://      # redis://... when running several API processes
# RATE_LIMIT_ANONYMOUS=50/hour
# RATE_LIMIT_AUTHENTICATED=500/hour
# RATE_LIMIT_AI_CHAT=100/day
# RATE_LIMIT_ROADMAP_GENERATION=10/day
# AUTH_CACHE_SECONDS=60
# LOG_FORMAT=                            # json | text
# SLOW_REQUEST_MS=1000

# --- Optional ----------------------------------------------------------------
# GITHUB_TOKEN=                          # raises GitHub's limit for project reviews
