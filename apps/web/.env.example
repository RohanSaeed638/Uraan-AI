# Copy to .env. NEXT_PUBLIC_* values are visible in the browser (and, in Docker/Vercel,
# fixed when the app is built), so never put a secret in them.

NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# The public ("anon" / publishable) key. Row Level Security keeps it from reading data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where the API is reachable from the browser (no trailing slash, no /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional
# NEXT_PUBLIC_SITE_URL=https://your-domain.com   # for the sitemap and share previews
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# INTERNAL_API_URL=http://api:8000               # server-side calls inside Docker
# NEXT_DIST_DIR=.next-test                       # a test build that leaves .next alone
